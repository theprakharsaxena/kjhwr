{
  "name": "windscope-root",
  "version": "1.0.0",
  "private": true,
  "description": "WindScope — Day-Ahead Intelligence Workspace",
  "scripts": {
    "dev": "./start.sh",
    "start": "./start.sh",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:backend": "./backend/venv/bin/python3 -m uvicorn app.main:app --app-dir backend --host 0.0.0.0 --port 8000 --reload",
    "build": "npm --prefix frontend run build",
    "test": "cd backend && PYTHONPATH=. ./venv/bin/pytest tests/ -v"
  }
}
